(window as any).__calls = [];
window.wangaohui = new Proxy({} as any, {
  get: (_, name: string) => {
    if (name.startsWith("on")) return () => () => {};
    return async (...args: any[]) => {
      (window as any).__calls.push({ name, args });
      if (name === "appVersion") return "1.0.2";
      if (name === "llmChat")
        return {
          ok: true,
          reply: "## 第一节\n这是大纲",
          content: "测试标题\n\n## 第一节\n\n测试正文。",
        };
      if (name === "generateArticle")
        return {
          ok: true,
          title: "测试文章",
          content: "测试标题\n\n## 第一节\n\n测试正文。",
          chinese: "测试标题\n\n## 第一节\n\n测试正文。",
          zh: "测试标题\n\n## 第一节\n\n测试正文。",
        };
      if (name === "platformPublish") return { ok: true };
      return {
        ok: true,
        entries: [],
        orders: [],
        files: [],
        images: [],
        accounts: [],
        version: "1.0.2",
        error: "",
      };
    };
  },
});
const realFetch = window.fetch.bind(window);
window.fetch = async (input: any, options: any) => {
  const url = String(input);
  if (!url.includes("159.75.139.210")) return realFetch(input, options);
  let data = url.includes("/categories")
    ? [{ category: "科技", count: 1 }]
    : url.includes("/articles")
      ? [
          {
            id: 1,
            title: "测试素材标题",
            category: "科技",
            platform: "微信24小时热榜",
            content_text: "测试素材正文",
            published_at: "2026-10-13T09:00:00",
          },
        ]
      : [];
  if (url.includes("/api/images"))
    data = [1, 2].map((id) => ({
      id,
      url:
        "data:image/svg+xml;charset=utf-8," +
        encodeURIComponent(
          `<svg xmlns="http://www.w3.org/2000/svg" width="240" height="180"><rect width="240" height="180" fill="${id === 1 ? "#dbeafe" : "#dcfce7"}"/></svg>`,
        ),
      title: "预览素材" + id,
      tags: [],
    })) as any;
  return new Response(
    JSON.stringify({
      code: 0,
      data,
      meta: { total: data.length, page: 1, page_size: 12 },
    }),
    { headers: { "Content-Type": "application/json" } },
  );
};

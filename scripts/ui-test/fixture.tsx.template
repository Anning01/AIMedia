// Test-only export comparison; baseline modules are created and removed by ui-check.
(window as any).__runExportChecks = async () => {
  const { ARTICLE_TEMPLATES } = await import("../../src/data/articleTemplates");
  const { SAMPLE_ARTICLE_BLOCKS } =
    await import("../../src/data/sampleArticle");
  const { buildInlineHtml } = await import("../../src/utils/articleHtml");
  const baselineHtml = await import(
    /* @vite-ignore */ "./.baseline-articleHtml.ts"
  );
  for (const t of ARTICLE_TEMPLATES) {
    const a = buildInlineHtml(SAMPLE_ARTICLE_BLOCKS, t, t.accent, {});
    const b = baselineHtml.buildInlineHtml(
      SAMPLE_ARTICLE_BLOCKS,
      t,
      t.accent,
      {},
    );
    if (a !== b) throw new Error("HTML export changed: " + t.id);
  }
  const { renderDesignPng } = await import("../../src/utils/renderDesignPng");
  const baselinePng = await import(
    /* @vite-ignore */ "./.baseline-renderDesignPng.ts"
  );
  const design = {
    width: 300,
    height: 400,
    bg: "linear-gradient(135deg,#2f54eb,#ffffff)",
    layers: [
      {
        text: "导出验证\n内容与排版保持一致",
        x: 10,
        y: 20,
        size: 22,
        color: "#202938",
        bold: true,
      },
    ],
  };
  const png = await renderDesignPng(design);
  if (png !== (await baselinePng.renderDesignPng(design)))
    throw new Error("Canvas PNG changed");
  const { STICKER_COVER_TEMPLATES } =
    await import("../../src/data/stickerTemplates");
  const { default: CoverThumb } =
    await import("../../src/components/CoverThumb");
  const { renderCoverNodeToPng } =
    await import("../../src/utils/renderCoverNode");
  const host = document.createElement("div");
  host.style.cssText =
    'position:fixed;top:0;left:0;width:168px;height:224px;z-index:9999;background:white;font:14px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif';
  document.body.appendChild(host);
  const root = createRoot(host);
  root.render(
    <CoverThumb
      tpl={STICKER_COVER_TEMPLATES[0]}
      title="导出样式验证"
      text="内容保持一致"
    />,
  );
  await new Promise((r) => setTimeout(r, 300));
  const newCover = await renderCoverNodeToPng(host, 336, 448);
  const sheets = [
    ...document.querySelectorAll<HTMLStyleElement>("style[data-vite-dev-id]"),
  ]
    .filter((s) => /\/(ui|workspace)\.css$/.test(s.dataset.viteDevId || ""))
    .map((s) => s.sheet!);
  sheets.forEach((s) => (s.disabled = true));
  try {
    const oldCover = await renderCoverNodeToPng(host, 336, 448);
    if (newCover !== oldCover)
      throw new Error("DOM cover affected by workspace styles");
  } finally {
    sheets.forEach((s) => (s.disabled = false));
    root.unmount();
    host.remove();
  }
  return { templates: ARTICLE_TEMPLATES.length, canvas: true, cover: true };
};
